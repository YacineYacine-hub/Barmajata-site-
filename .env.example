# Copier en .env.local pour le développement local (fichier ignoré par git).

# Charge le contenu de démonstration (src/content/_demo/) en plus du
# contenu réel (src/content/) : 3 livres factices (publié 3 formats, à
# paraître, brouillon) + 2 auteurs factices, avec ASIN/ISBN au bon format
# mais fictifs. Sert uniquement à juger l'esthétique et le fonctionnel sur
# un catalogue rempli, sans contenu réel.
#
# Fixée au build (préfixe NEXT_PUBLIC_) : bascule entre les deux modes en
# relançant `npm run build`, pas au runtime.
#
# JAMAIS "true" en production (Vercel) — laisser absent ou "false".
NEXT_PUBLIC_DEMO_CONTENT=false

# Inscription au club (double opt-in) — voir src/lib/club/. Un SEUL des
# deux fournisseurs ci-dessous doit être défini (BREVO_API_KEY prioritaire
# si les deux le sont). Aucun des deux défini → le formulaire /club reste
# inerte avec un message clair (pas d'échec silencieux).
#
# Vérifié UNIQUEMENT par relecture du format des requêtes attendu par
# chaque fournisseur — jamais testé avec une vraie clé (pas d'accès
# réseau sortant ni de navigateur dans cette session).
BREVO_API_KEY=
BREVO_LIST_ID=
# ou
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Requis dès qu'un fournisseur est configuré (adresse/nom d'expéditeur des
# e-mails transactionnels).
CLUB_FROM_EMAIL=
CLUB_FROM_NAME=BARMAJATA

# Secret HMAC signant le jeton de confirmation du double opt-in
# (src/lib/club/token.ts). Aucune base de données en Phase 1 : le jeton
# porte lui-même l'e-mail et son expiration (48h), signés — pas de
# session de confirmation stockée côté serveur. Générer une valeur longue
# et aléatoire, ex. `openssl rand -base64 32`.
CLUB_CONFIRM_SECRET=
